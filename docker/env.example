# RAGFlow 配置
RAGFLOW_BASE_URL=http://localhost
RAGFLOW_API_KEY=ragflow-yourkey

# PostgreSQL 数据库配置 (内部端口: 5432, 外部调试端口: 5433)
POSTGRES_DB=simplemanus
POSTGRES_USER=simplemanus
POSTGRES_PASSWORD=your_postgres_password_here

# MinIO 对象存储配置 (内部端口: 9000, 控制台: 9001)
MINIO_ACCESS_KEY=simplemanus
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET_NAME=simplemanus-files
MINIO_USE_SSL=false

# MongoDB 日志存储配置 (内部端口: 27017, 外部调试端口: 27018)
MONGODB_USERNAME=simplemanus
MONGODB_PASSWORD=your_mongodb_password_here
MONGODB_DATABASE=simplemanus

# Redis 配置 (内部端口: 9736, 不对外暴露)
REDIS_DB=0

# 存储目录配置
CONTEXT_DIR=data/contexts
SKETCH_DIR=data/sketches 

# 日志配置
LOG_DIR=./agent_logs
LOG_LEVEL=WARNING